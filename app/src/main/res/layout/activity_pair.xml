<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cockpit_black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBack"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:minWidth="64dp"
                android:text="@string/pair_back"
                android:textColor="@color/ink_slate"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/txtPairTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-condensed"
                android:text="@string/pair_host_title"
                android:textColor="@color/ink_white"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleTransportMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:checkedButton="@+id/btnTabQr"
            app:selectionRequired="true"
            app:singleSelection="true"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTabQr"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="@string/tab_qr_link"
                android:textColor="@color/ink_white" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTabIphone"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="@string/tab_iphone_obr"
                android:textColor="@color/ink_white"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTabManual"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="@string/tab_manual_lan"
                android:textColor="@color/ink_white" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <LinearLayout
            android:id="@+id/bannerPreFlight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_alert_strip"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/txtPreFlightMsg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/location_required_banner"
                android:textColor="@color/signal_amber"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPreFlightAction"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/signal_amber"
                android:text="@string/open_location_settings"
                android:textColor="@color/cockpit_black" />
        </LinearLayout>

        <!-- HOST PANEL -->
        <LinearLayout
            android:id="@+id/panelHost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggleIphoneStep"
                xmlns:app="http://schemas.android.com/apk/res-auto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:checkedButton="@+id/btnIphoneStepWifi"
                android:visibility="gone"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnIphoneStepWifi"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:text="@string/iphone_step_wifi"
                    android:textColor="@color/ink_white" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnIphoneStepSafari"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:text="@string/iphone_step_safari"
                    android:textColor="@color/ink_white" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <FrameLayout
                android:layout_width="260dp"
                android:layout_height="260dp"
                android:background="@color/qr_frame_white"
                android:padding="12dp">

                <ImageView
                    android:id="@+id/imgQrCode"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/tab_qr_link"
                    android:scaleType="fitCenter" />
            </FrameLayout>

            <TextView
                android:id="@+id/txtHostStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/host_starting_hotspot"
                android:textColor="@color/live_emerald"
                android:textSize="16sp" />

            <LinearLayout
                android:id="@+id/panelHostManualInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_status_pill"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/txtHostAddress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:textColor="@color/ink_white"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/txtHostSessionCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFeatureSettings="tnum"
                    android:textColor="@color/signal_amber"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- JOIN QR PANEL -->
        <LinearLayout
            android:id="@+id/panelJoinQr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnScanQr"
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:backgroundTint="@color/signal_amber"
                android:text="@string/join_scan_qr_button"
                android:textColor="@color/cockpit_black"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtJoinStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:textColor="@color/ink_slate"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- JOIN MANUAL LAN PANEL -->
        <LinearLayout
            android:id="@+id/panelJoinManual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/edtHostIp"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_status_pill"
                android:fontFeatureSettings="tnum"
                android:hint="@string/manual_ip_hint"
                android:importantForAutofill="no"
                android:inputType="phone"
                android:paddingHorizontal="16dp"
                android:textColor="@color/ink_white"
                android:textColorHint="@color/ink_slate" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/edtPort"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_status_pill"
                    android:fontFeatureSettings="tnum"
                    android:hint="@string/manual_port_hint"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:paddingHorizontal="16dp"
                    android:text="49152"
                    android:textColor="@color/ink_white"
                    android:textColorHint="@color/ink_slate" />

                <EditText
                    android:id="@+id/edtSessionCode"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_status_pill"
                    android:fontFeatureSettings="tnum"
                    android:hint="@string/manual_code_hint"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="4"
                    android:paddingHorizontal="16dp"
                    android:textColor="@color/ink_white"
                    android:textColorHint="@color/ink_slate" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnManualConnect"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/live_emerald"
                android:text="@string/manual_connect_button"
                android:textColor="@color/cockpit_black"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ERROR / RETRY STRIP -->
        <LinearLayout
            android:id="@+id/bannerError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_alert_strip"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/txtErrorMsg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/cutoff_crimson"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRetry"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/panel_pressed"
                android:text="@string/retry_button"
                android:textColor="@color/ink_white" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
