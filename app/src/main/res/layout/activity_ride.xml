<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cockpit_black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- TOP COCKPIT STATUS PILLS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_status_pill"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pill_link"
                    android:textColor="@color/ink_slate"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/txtPillLink"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:text="Connected"
                    android:textColor="@color/live_emerald"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_status_pill"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pill_audio"
                    android:textColor="@color/ink_slate"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/txtPillAudio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Speaker"
                    android:textColor="@color/ink_white"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_status_pill"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pill_mode"
                    android:textColor="@color/ink_slate"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/txtPillMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mode_hands_free"
                    android:textColor="@color/ink_white"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- CONDITIONAL ALERT STRIP -->
        <TextView
            android:id="@+id/txtRideAlert"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_alert_strip"
            android:padding="12dp"
            android:textColor="@color/signal_amber"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- GROUP ROSTER (Phase 2 M1): who's in the ride and what each rider is doing -->
        <LinearLayout
            android:id="@+id/panelRoster"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@color/panel_asphalt"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/txtRosterTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/roster_title"
                android:textColor="@color/ink_slate"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/rosterList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- CENTER SIGNATURE COCKPIT SWITCH -->
        <LinearLayout
            android:id="@+id/btnCockpitCenter"
            android:layout_width="216dp"
            android:layout_height="216dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_cockpit_ring_live"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/txtCenterPrimary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:gravity="center"
                android:text="@string/mic_live"
                android:textColor="@color/ink_white"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtCenterSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="@string/mic_live_sub"
                android:textColor="@color/ink_slate"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- MODE TOGGLE -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleTalkMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:checkedButton="@+id/btnModeHandsFree"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnModeHandsFree"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="@string/mode_hands_free"
                android:textColor="@color/ink_white" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnModePtt"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="@string/mode_ptt"
                android:textColor="@color/ink_white" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- WIND GATE SLIDER -->
        <LinearLayout
            android:id="@+id/panelWindGate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_status_pill"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/wind_gate_label"
                    android:textColor="@color/ink_white"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/txtWindGateValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:text="Low (150)"
                    android:textColor="@color/signal_amber"
                    android:textSize="14sp" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/seekWindGate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:max="2000"
                android:progress="150" />
        </LinearLayout>

        <!-- GROUP MUSIC (Phase 2 M3, docs/adr/0003): the Host's player; everyone picks a level -->
        <LinearLayout
            android:id="@+id/panelMusic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_status_pill"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/music_title"
                android:textColor="@color/ink_slate"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/txtNowPlaying"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/ink_white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/rowMusicTransport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMusicAdd"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1.6"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/music_add"
                    android:textColor="@color/ink_white"
                    app:icon="@drawable/ic_music_add"
                    app:iconTint="@color/ink_white" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMusicPrevious"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/music_previous"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    app:icon="@drawable/ic_music_previous"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconTint="@color/ink_white" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMusicPlay"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/music_play"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    app:icon="@drawable/ic_music_play"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconTint="@color/ink_white" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMusicNext"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/music_next"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    app:icon="@drawable/ic_music_next"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconTint="@color/ink_white" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/music_level_label"
                android:textColor="@color/ink_slate"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggleMusicLevel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMusicOff"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:text="@string/music_level_off"
                    android:textColor="@color/ink_white" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMusicLow"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:text="@string/music_level_low"
                    android:textColor="@color/ink_white" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMusicMedium"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:text="@string/music_level_medium"
                    android:textColor="@color/ink_white" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMusicFull"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:text="@string/music_level_full"
                    android:textColor="@color/ink_white" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
        </LinearLayout>

        <!-- DIAGNOSTICS & END RIDE ACTIONS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleDiagnostics"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="@string/diagnostics_button"
                android:textColor="@color/ink_white" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEndRide"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:backgroundTint="@color/cutoff_crimson"
                android:text="@string/end_ride_button"
                android:textColor="@color/ink_white"
                android:textStyle="bold" />
        </LinearLayout>

        <include
            android:id="@+id/diagnosticsDrawer"
            layout="@layout/view_diagnostics_drawer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
